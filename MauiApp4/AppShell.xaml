<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiApp4.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp4"
    xmlns:views="clr-namespace:MauiApp4.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="MauiApp4">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <!-- Sección Inicio -->
    <!--<FlyoutItem Title="Inicio" >
        <ShellContent Title="Home" ContentTemplate="{DataTemplate views:GetStarted}" />
    </FlyoutItem>-->

    <!-- Sección Registro -->
    <FlyoutItem Title="Registro">
        <ShellContent Title="Register" ContentTemplate="{DataTemplate views:RegisterPage}" />
    </FlyoutItem>

    <!-- Sección Bienvenida -->
    <FlyoutItem Title="Bienvenida">
        <ShellContent Title="Welcome" ContentTemplate="{DataTemplate views:WelcomePage}" />
    </FlyoutItem>
</Shell>
